<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TaskManager.Views;assembly=TaskManager.Views"
    Title="Projects"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <Label Text="Projects"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#1E293B"
               Margin="0,0,0,20"/>

        <CollectionView x:Name="ProjectsList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnProjectSelected">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:ProjectView">

                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="14"
                            Margin="8"
                            HeightRequest="160">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="#475569"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>
                            <ProgressBar HeightRequest="6"
                                         Margin="0,6,0,0"
                                         Progress="{Binding Progress, Converter={StaticResource ProgressConverter}}"
                                         ProgressColor="#3B82F6"
                                         BackgroundColor="#E5E7EB"/>
                            <Label Text="{Binding Progress, StringFormat='{}{0}%'}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   TextColor="#3B82F6"
                                   FontAttributes="Bold"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

