<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:TaskManager.Services.DTO;assembly=TaskManager.Services"
    x:Name="PageRoot"
    Title="Projects"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <Label Text="Projects"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#1E293B"
               Margin="0,0,0,20"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Projects}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ProjectListDto">

                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="14"
                            Margin="8">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="Black"/>

                            <Label Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="#64748B"/>

                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="#475569"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>

                            <ProgressBar HeightRequest="6"
                                         Margin="0,6,0,0"
                                         Progress="{Binding Progress, Converter={StaticResource ProgressConverter}}"
                                         ProgressColor="#3B82F6"
                                         BackgroundColor="#E5E7EB"/>

                            <Label Text="{Binding Progress, StringFormat='{}{0}%'}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   TextColor="#3B82F6"
                                   FontAttributes="Bold"/>

                            <Button Text="Open"
                                    HorizontalOptions="End"
                                    WidthRequest="90"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    CornerRadius="12"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProjectCommand}"
                                    CommandParameter="{Binding Id}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>