<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:TaskManager.Services.DTO;assembly=TaskManager.Services"
    x:Name="PageRoot"
    Title="Project Details"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <Label Text="{Binding ProjectName}"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#1E293B"/>

        <Label Grid.Row="1"
               Text="{Binding ProjectDescription}"
               TextColor="#64748B"
               Margin="0,6,0,20"/>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Tasks}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="1"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:TaskListDto">

                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Padding="14"
                            Margin="8">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#1E293B"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"/>

                            <Label Text="{Binding Priority}"
                                   FontSize="12"
                                   TextColor="#64748B"/>

                            <Label FontSize="12"
                                   FontAttributes="Bold">

                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsFinished}"
                                                 Value="True">
                                        <Setter Property="Text" Value="DONE"/>
                                        <Setter Property="TextColor" Value="Green"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsOverdue}"
                                                 Value="True">
                                        <Setter Property="Text" Value="OVERDUE"/>
                                        <Setter Property="TextColor" Value="Red"/>
                                    </DataTrigger>
                                </Label.Triggers>

                            </Label>

                            <Button Text="Open"
                                    HorizontalOptions="End"
                                    WidthRequest="90"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    CornerRadius="12"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTaskCommand}"
                                    CommandParameter="{Binding Id}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>