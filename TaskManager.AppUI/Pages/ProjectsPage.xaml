<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:TaskManager.Services.DTO;assembly=TaskManager.Services"
    x:Name="PageRoot"
    Title="Projects"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <Label Text="Projects"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#1E293B"
               Margin="0,0,0,12" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             Margin="0,0,0,16">

            <Border Stroke="#CBD5E1"
                    StrokeThickness="1.5"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Padding="8,0">
                <SearchBar Text="{Binding SearchText}"
                           Placeholder="Search projects"
                           IsEnabled="{Binding IsNotBusy}"
                           BackgroundColor="Transparent"
                           TextColor="#1E293B"
                           PlaceholderColor="#94A3B8" />
            </Border>
            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center"
                        BindableLayout.EmptyView="">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      Margin="0,0,12,8"
                      MinimumWidthRequest="220">
                    <Label Grid.Column="0"
                           Text="Type"
                           VerticalOptions="Center"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#475569" />

                    <Border Grid.Column="1"
                            Stroke="#CBD5E1"
                            StrokeThickness="1.5"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,0"
                            MinimumWidthRequest="150">
                        <Picker ItemsSource="{Binding TypeOptions}"
                                SelectedItem="{Binding SelectedTypeOption}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="Transparent"
                                TextColor="#1E293B"
                                TitleColor="#64748B" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      Margin="0,0,0,8"
                      MinimumWidthRequest="220">
                    <Label Grid.Column="0"
                           Text="Sort"
                           VerticalOptions="Center"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#475569" />

                    <Border Grid.Column="1"
                            Stroke="#CBD5E1"
                            StrokeThickness="1.5"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,0"
                            MinimumWidthRequest="150">
                        <Picker ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SelectedSortOption}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="Transparent"
                                TextColor="#1E293B"
                                TitleColor="#64748B" />
                    </Border>
                </Grid>
            </FlexLayout>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Apply"
                        Command="{Binding ReloadProjectsCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="44"
                        Padding="18,10" />

                <Button Text="Clear"
                        Command="{Binding ClearFiltersCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#0EA5E9"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="44"
                        Padding="18,10" />

                <Button Text="Add"
                        Command="{Binding AddProjectCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="44"
                        Padding="18,10" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Projects}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ProjectListDto">
                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="14"
                            Margin="8">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="Black" />

                            <Label Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="#64748B" />

                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="#475569"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />

                            <ProgressBar HeightRequest="6"
                                         Margin="0,6,0,0"
                                         Progress="{Binding Progress, Converter={StaticResource ProgressConverter}}"
                                         ProgressColor="#3B82F6"
                                         BackgroundColor="#E5E7EB" />

                            <Label Text="{Binding Progress, StringFormat='{}{0}%'}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   TextColor="#3B82F6"
                                   FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="Open"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        FontSize="13"
                                        Padding="10,8"
                                        HorizontalOptions="Fill"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProjectCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Grid.Column="1"
                                        Text="Delete"
                                        BackgroundColor="#EF4444"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        FontSize="13"
                                        Padding="10,8"
                                        HorizontalOptions="Fill"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteProjectCommand}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#66000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Color="White" />
                <Label Text="Loading..."
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>