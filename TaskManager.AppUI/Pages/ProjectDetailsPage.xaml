<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:TaskManager.Services.DTO;assembly=TaskManager.Services"
    x:Name="PageRoot"
    Title="Project Details"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <Border Stroke="#E2E8F0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 18"
                Padding="16"
                Margin="0,0,0,14">

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ProjectName}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />

                <Label Text="{Binding ProjectTypeText}"
                       FontSize="13"
                       TextColor="#64748B" />

                <Label Text="{Binding ProjectProgressText}"
                       FontSize="13"
                       TextColor="#2563EB"
                       FontAttributes="Bold" />

                <Label Text="{Binding ProjectStatsText}"
                       FontSize="13"
                       TextColor="#475569" />

                <Label Text="{Binding ProjectDescription}"
                       FontSize="14"
                       TextColor="#334155"
                       LineBreakMode="WordWrap" />

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Edit project"
                            Command="{Binding EditProjectCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                    <Button Text="Delete project"
                            Command="{Binding DeleteProjectCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#FEE2E2"
                            TextColor="#B91C1C" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             Margin="0,0,0,14">

            <SearchBar Text="{Binding TaskSearchText}"
                       Placeholder="Search tasks"
                       IsEnabled="{Binding IsNotBusy}" />

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10">
                <Picker Grid.Column="0"
                        Title="Priority"
                        ItemsSource="{Binding PriorityOptions}"
                        SelectedItem="{Binding SelectedPriorityOption}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Picker Grid.Column="1"
                        Title="Status"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatusOption}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Picker Grid.Column="2"
                        Title="Sort"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Apply"
                        Command="{Binding ReloadProjectCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Button Text="Clear"
                        Command="{Binding ClearTaskFiltersCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Button Text="Add task"
                        Command="{Binding AddTaskCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Tasks}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="1" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:TaskListDto">
                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Padding="14"
                            Margin="8">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#1E293B"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />

                            <Label Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                   FontSize="12"
                                   TextColor="#64748B" />

                            <Label Text="IN PROGRESS"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsFinished}"
                                                 Value="True">
                                        <Setter Property="Text" Value="DONE" />
                                        <Setter Property="TextColor" Value="Green" />
                                    </DataTrigger>

                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsOverdue}"
                                                 Value="True">
                                        <Setter Property="Text" Value="OVERDUE" />
                                        <Setter Property="TextColor" Value="Red" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <HorizontalStackLayout HorizontalOptions="End"
                                                   Spacing="8">
                                <Button Text="Open"
                                        WidthRequest="90"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        CornerRadius="12"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTaskCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Text="Delete"
                                        WidthRequest="90"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#B91C1C"
                                        CornerRadius="12"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteTaskCommand}"
                                        CommandParameter="{Binding Id}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#66000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Color="White" />
                <Label Text="Loading..."
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>