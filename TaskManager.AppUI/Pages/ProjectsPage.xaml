<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:TaskManager.Services.DTO;assembly=TaskManager.Services"
    x:Name="PageRoot"
    Title="Projects"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <Label Text="Projects"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#1E293B"
               Margin="0,0,0,12" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             Margin="0,0,0,16">

            <SearchBar Text="{Binding SearchText}"
                       Placeholder="Search projects"
                       IsEnabled="{Binding IsNotBusy}" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">
                <Picker Grid.Column="0"
                        Title="Type"
                        ItemsSource="{Binding TypeOptions}"
                        SelectedItem="{Binding SelectedTypeOption}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Picker Grid.Column="1"
                        Title="Sort"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Apply"
                        Command="{Binding ReloadProjectsCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Button Text="Clear"
                        Command="{Binding ClearFiltersCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Button Text="Add"
                        Command="{Binding AddProjectCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Projects}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ProjectListDto">
                    <Border Stroke="#E2E8F0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="14"
                            Margin="8">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="Black" />

                            <Label Text="{Binding Type}"
                                   FontSize="12"
                                   TextColor="#64748B" />

                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="#475569"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />

                            <ProgressBar HeightRequest="6"
                                         Margin="0,6,0,0"
                                         Progress="{Binding Progress, Converter={StaticResource ProgressConverter}}"
                                         ProgressColor="#3B82F6"
                                         BackgroundColor="#E5E7EB" />

                            <Label Text="{Binding Progress, StringFormat='{}{0}%'}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   TextColor="#3B82F6"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout HorizontalOptions="End"
                                                   Spacing="8">
                                <Button Text="Open"
                                        WidthRequest="90"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        CornerRadius="12"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProjectCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Text="Delete"
                                        WidthRequest="90"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#B91C1C"
                                        CornerRadius="12"
                                        IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteProjectCommand}"
                                        CommandParameter="{Binding Id}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#66000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Color="White" />
                <Label Text="Loading..."
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>