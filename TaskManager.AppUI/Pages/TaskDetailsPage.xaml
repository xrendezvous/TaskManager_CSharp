<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.TaskDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Task Details"
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label x:Name="TitleLabel"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="Black"/>
                    <Label x:Name="PriorityLabel"
                           FontSize="14"
                           TextColor="Black"/>
                    <Label x:Name="DueLabel"
                           FontSize="14"
                           TextColor="Black"/>

                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="#F9FAFB"
                    Padding="16"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="8">

                    <Label Text="Status"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Label x:Name="DoneLabel"
                           FontSize="14"
                           TextColor="Black"/>
                    <Label x:Name="OverdueLabel"
                           FontSize="14"
                           TextColor="Black"/>

                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="10">
                    <Label Text="Description"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Label x:Name="DescLabel"
                           LineBreakMode="WordWrap"/>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="12">

                <Button Text="Edit"
                        IsEnabled="False"
                        BackgroundColor="#E5E7EB"
                        TextColor="Gray"
                        CornerRadius="10"/>

                <Button Text="Delete"
                        IsEnabled="False"
                        BackgroundColor="#FEE2E2"
                        TextColor="#B91C1C"
                        CornerRadius="10"/>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

