<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskManager.AppUI.ProjectDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TaskManager.Views;assembly=TaskManager.Views"
    Title="Project Detail"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="15">

        <Label x:Name="ProjectTitle"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="Black"/>
        
        <Label x:Name="ProjectDescription"
               Grid.Row="1"
               TextColor="Gray"
               Margin="0,6,0,12"/>

        <CollectionView x:Name="TasksList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnTaskSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:TaskView">

                    <Border Stroke="#E5E7EB"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="14"
                            Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 12">

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto">

                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   Grid.ColumnSpan="2"/>

                            <Label Grid.Row="1"
                                   Text="{Binding Priority}"
                                   FontSize="13"
                                   TextColor="#6B7280"/>

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalOptions="End"
                                   FontAttributes="Bold">

                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsFinished}"
                                                 Value="True">
                                        <Setter Property="Text" Value="DONE"/>
                                        <Setter Property="TextColor" Value="Green"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsOverdue}"
                                                 Value="True">
                                        <Setter Property="Text" Value="OVERDUE"/>
                                        <Setter Property="TextColor" Value="Red"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>